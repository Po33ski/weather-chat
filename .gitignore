###############################
# Root .gitignore (consolidated)
###############################

# Environment Variables
env-scratchpad.sh
.env
.env.local
.env.*.local
.env*.local

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Dependencies
node_modules/
**/__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/

# Frontend build artifacts
frontend/.vercel/
frontend/coverage/
frontend/.pnp
frontend/.pnp.js
frontend/.yarn/install-state.gz
frontend/*.tsbuildinfo
frontend/build/

# Backend build artifacts
dist/
build/
*.egg-info/


# Certificates/keys
*.pem

# Temporary files
*.tmp
*.temp